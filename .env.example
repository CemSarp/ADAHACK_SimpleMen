# Chatbot configuration (placeholders only; never commit real values).
# The app reads these from the process environment; it does not auto-load this file.
# Example: set -a; source .env; set +a; .venv/bin/python -m streamlit run app.py

# The analysis dashboard uses the integrated company services.
# Optional alternative company configuration (default: config/integration.json)
# CARBONOPT_CONFIG=config/integration.json

# mock (default guided assistant, no network), lmstudio (LM Studio's local server on this
# machine, tested with google/gemma-4-12b) or ollama (an Ollama server you point it at)
CHATBOT_PROVIDER=mock

# Required when CHATBOT_PROVIDER=ollama. Remote endpoint supplied by the deployment, e.g. https://<host>:11434
OLLAMA_BASE_URL=

# Instruction-tuned model tag served by that endpoint
OLLAMA_MODEL=llama3.1:8b

# Request timeout in seconds and maximum generated tokens per reply
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_OUTPUT_TOKENS=512

# Optional bearer token, only if the endpoint sits behind an authenticating gateway
OLLAMA_API_KEY=

# LM Studio (CHATBOT_PROVIDER=lmstudio). Defaults shown; start the server with `lms server start`
# and load the model with `lms load google/gemma-4-12b`.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-12b
LMSTUDIO_TIMEOUT_SECONDS=300
LMSTUDIO_MAX_OUTPUT_TOKENS=4096
# Only if you enabled authentication in LM Studio's server settings
LMSTUDIO_API_KEY=
